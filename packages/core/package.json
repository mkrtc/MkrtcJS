{
  "name": "mkrtcjs-core",
  "version": "2.0.0",
  "description": "Core package for MkrtcJS — includes dependency injection, metadata handling, and base architecture utilities.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "copy-readme": "cp ../../readme.md ./README.md",
    "build": "npm run copy-readme && npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "pub": "npm publish --no-git-checks"
  },
  "keywords": [
    "typescript",
    "react",
    "architecture",
    "nest-inspired",
    "dependency-injection",
    "decorators"
  ],
  "author": "mkrtc <mkrtc.sarkis@gmail.com> (https://www.npmjs.com/~mkrtc)",
  "license": "MIT",

  "bugs": {
    "url": "https://github.com/mkrtc/MkrtcJS/issues",
    "email": "mkrtc.sarkis@gmail.com"
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/mkrtc/MkrtcJS/tree/main/packages/core"    
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts",
      "require": "./dist/client/index.js"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.js"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts",
      "require": "./dist/types/index.js"
    }
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "next": "^15.3.2",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  }
}
